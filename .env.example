# Copy to .env — never commit .env. All settings are prefixed ONIX_.

# --- LLM (at least one provider for hunt/verify/fix; none needed for index/analyze) ---
ONIX_ANTHROPIC_API_KEY=
ONIX_OPENAI_API_KEY=
ONIX_DEEPSEEK_API_KEY=
ONIX_OPENROUTER_API_KEY=
# Model settings accept a COMMA-SEPARATED ROTATION LIST. Onix tries them in order, moves to
# the next on a rate limit or error, and keeps using the one that last worked. Free example:
ONIX_PRIMARY_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/poolside/laguna-s-2.1:free,openrouter/thinkingmachines/inkling-small:free,openrouter/inclusionai/ling-3.0-flash-fin:free
ONIX_CHEAP_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free,openrouter/google/gemma-4-26b-a4b-it:free,openrouter/poolside/laguna-xs-2.1:free,openrouter/nvidia/nemotron-3-super-120b-a12b:free
ONIX_FALLBACK_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# Free tiers are rate-limited and may ignore JSON-schema enforcement; Onix switches to
# prompt-embedded schemas for openrouter/ models automatically (ONIX_STRUCTURED_OUTPUT_MODE=auto).
# Paid defaults (uncomment if you have Anthropic/OpenAI keys):
# ONIX_PRIMARY_MODEL=anthropic/claude-sonnet-5
# ONIX_CHEAP_MODEL=anthropic/claude-haiku-4-5-20251001
# ONIX_FALLBACK_MODEL=openai/gpt-5
ONIX_EMBEDDING_MODEL=text-embedding-3-large
ONIX_VOYAGE_API_KEY=

# --- storage / telemetry ---
ONIX_DATABASE_URL=sqlite:///onix.db
# ONIX_DATABASE_URL=postgresql+psycopg://onix:onix@localhost:5432/onix
ONIX_WORK_DIR=.onix
ONIX_OTLP_ENDPOINT=
# ONIX_OTLP_ENDPOINT=http://localhost:4317
ONIX_LOG_JSON=0
ONIX_LOG_LEVEL=INFO

# --- GitHub (PR creation) ---
ONIX_GITHUB_TOKEN=
ONIX_PR_GROUPED=false

# --- API (leave API_KEYS empty for open dev mode; REQUIRED in production) ---
ONIX_API_HOST=127.0.0.1
ONIX_API_PORT=8000
ONIX_API_KEYS=[{"key":"change-me-admin","name":"admin","role":"admin"},{"key":"change-me-ci","name":"ci","role":"operator"}]
ONIX_API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
ONIX_API_RATE_LIMIT_PER_MINUTE=120
# auto = shared through the database when EXECUTION_MODE=queue, per-process otherwise; or memory|db
ONIX_API_RATE_LIMIT_BACKEND=auto
ONIX_MAX_CONCURRENT_RUNS=2

# --- budgets / graph ---
ONIX_BUDGET__MAX_USD=5
ONIX_BUDGET__MAX_MINUTES=60
ONIX_BUDGET__MAX_FINDINGS=25
ONIX_HUNT_CONCURRENCY=4
ONIX_PLAN_MAX_TARGETS=8
ONIX_TRIAGE_THRESHOLD=0.35
ONIX_ANALYZERS_SEMGREP=true

# --- execution / retention ---
ONIX_EXECUTION_MODE=inline          # queue → API only enqueues; run `onix worker`
ONIX_RETENTION_DAYS=30               # `onix gc` / startup sweep window
ONIX_GC_ON_STARTUP=true
ONIX_LLM_BACKOFF_S=5                 # pause between passes over the model pool
# ONIX_MODEL_PRICES={"openrouter/": {"input_per_m": 0, "output_per_m": 0}}

# --- OIDC / SSO (optional; API keys keep working alongside) ---
ONIX_OIDC_ISSUER=
ONIX_OIDC_AUDIENCE=
ONIX_OIDC_ROLE_CLAIM=groups
# ONIX_OIDC_ROLE_MAP={"onix-admin":"admin","onix-operator":"operator"}

# Any value above may be a secret reference: file:///run/secrets/x, env://VAR,
# vault://secret/data/onix#key, aws-sm://name#key, gcp-sm://projects/p/secrets/s

# --- triage model (Phase 7) ---
ONIX_TRIAGE_ENDPOINT=
ONIX_TRIAGE_MODEL=onix-triage
