# Copy to .env — never commit .env. All settings are prefixed SENTINEL_.

# --- LLM (at least one provider for hunt/verify/fix; none needed for index/analyze) ---
SENTINEL_ANTHROPIC_API_KEY=
SENTINEL_OPENAI_API_KEY=
SENTINEL_DEEPSEEK_API_KEY=
SENTINEL_OPENROUTER_API_KEY=
# Model settings accept a COMMA-SEPARATED ROTATION LIST. Sentinel tries them in order, moves to
# the next on a rate limit or error, and keeps using the one that last worked. Free example:
SENTINEL_PRIMARY_MODEL=openrouter/nvidia/nemotron-3-ultra-550b-a55b:free,openrouter/nvidia/nemotron-3-super-120b-a12b:free,openrouter/poolside/laguna-s-2.1:free,openrouter/thinkingmachines/inkling-small:free,openrouter/inclusionai/ling-3.0-flash-fin:free
SENTINEL_CHEAP_MODEL=openrouter/nvidia/nemotron-3.5-lightning:free,openrouter/google/gemma-4-26b-a4b-it:free,openrouter/poolside/laguna-xs-2.1:free,openrouter/nvidia/nemotron-3-super-120b-a12b:free
SENTINEL_FALLBACK_MODEL=openrouter/nvidia/nemotron-3-super-120b-a12b:free
# Free tiers are rate-limited and may ignore JSON-schema enforcement; Sentinel switches to
# prompt-embedded schemas for openrouter/ models automatically (SENTINEL_STRUCTURED_OUTPUT_MODE=auto).
# Paid defaults (uncomment if you have Anthropic/OpenAI keys):
# SENTINEL_PRIMARY_MODEL=anthropic/claude-sonnet-5
# SENTINEL_CHEAP_MODEL=anthropic/claude-haiku-4-5-20251001
# SENTINEL_FALLBACK_MODEL=openai/gpt-5
SENTINEL_EMBEDDING_MODEL=text-embedding-3-large
SENTINEL_VOYAGE_API_KEY=

# --- storage / telemetry ---
SENTINEL_DATABASE_URL=sqlite:///sentinel.db
# SENTINEL_DATABASE_URL=postgresql+psycopg://sentinel:sentinel@localhost:5432/sentinel
SENTINEL_WORK_DIR=.sentinel
SENTINEL_OTLP_ENDPOINT=
# SENTINEL_OTLP_ENDPOINT=http://localhost:4317
SENTINEL_LOG_JSON=0
SENTINEL_LOG_LEVEL=INFO

# --- GitHub (PR creation) ---
SENTINEL_GITHUB_TOKEN=
SENTINEL_PR_GROUPED=false

# --- API (leave API_KEYS empty for open dev mode; REQUIRED in production) ---
SENTINEL_API_HOST=127.0.0.1
SENTINEL_API_PORT=8000
SENTINEL_API_KEYS=[{"key":"change-me-admin","name":"admin","role":"admin"},{"key":"change-me-ci","name":"ci","role":"operator"}]
SENTINEL_API_CORS_ORIGINS=http://localhost:5173,http://localhost:8000
SENTINEL_API_RATE_LIMIT_PER_MINUTE=120
SENTINEL_MAX_CONCURRENT_RUNS=2

# --- budgets / graph ---
SENTINEL_BUDGET__MAX_USD=5
SENTINEL_BUDGET__MAX_MINUTES=60
SENTINEL_BUDGET__MAX_FINDINGS=25
SENTINEL_HUNT_CONCURRENCY=4
SENTINEL_PLAN_MAX_TARGETS=8
SENTINEL_TRIAGE_THRESHOLD=0.35
SENTINEL_ANALYZERS_SEMGREP=true

# --- execution / retention ---
SENTINEL_EXECUTION_MODE=inline          # queue → API only enqueues; run `sentinel worker`
SENTINEL_RETENTION_DAYS=30               # `sentinel gc` / startup sweep window
SENTINEL_GC_ON_STARTUP=true
SENTINEL_LLM_BACKOFF_S=5                 # pause between passes over the model pool
# SENTINEL_MODEL_PRICES={"openrouter/": {"input_per_m": 0, "output_per_m": 0}}

# --- OIDC / SSO (optional; API keys keep working alongside) ---
SENTINEL_OIDC_ISSUER=
SENTINEL_OIDC_AUDIENCE=
SENTINEL_OIDC_ROLE_CLAIM=groups
# SENTINEL_OIDC_ROLE_MAP={"sentinel-admin":"admin","sentinel-operator":"operator"}

# Any value above may be a secret reference: file:///run/secrets/x, env://VAR,
# vault://secret/data/sentinel#key, aws-sm://name#key, gcp-sm://projects/p/secrets/s

# --- triage model (Phase 7) ---
SENTINEL_TRIAGE_ENDPOINT=
SENTINEL_TRIAGE_MODEL=sentinel-triage
